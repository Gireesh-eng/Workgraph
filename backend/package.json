{
    "name": "workgraph-backend",
    "version": "1.0.0",
    "description": "WorkGraph API — explore organizational graph data via CognoDB",
    "main": "dist/src/server.js",
    "scripts": {
        "dev": "ts-node src/server.ts",
        "build": "tsc",
        "start": "node dist/src/server.js",
        "seed": "ts-node seed/seed.ts",
        "lint": "eslint src/ seed/ test/ --ext .ts",
        "format": "prettier --write \"src/**/*.ts\" \"seed/**/*.ts\" \"test/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"seed/**/*.ts\" \"test/**/*.ts\"",
        "test": "jest"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.0",
        "neo4j-driver": "^5.24.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.5.0",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "jest": "^30.4.2",
        "prettier": "^3.9.6",
        "ts-jest": "^29.4.12",
        "ts-node": "^10.9.2",
        "typescript": "^5.5.4"
    }
}
